@startuml
!include ../helper.puml

' Playersは全ドメインから参照される中心的なテーブルのため、
' どのパッケージにも属させず単独で配置する
!include ../src/tables/Players.puml

package " プレイヤー・レート管理情報 " {
    !include ../src/tables/Aliases.puml
    !include ../src/tables/Seasons.puml
    !include ../src/tables/PlayerSeasonRatings.puml
    !include ../src/tables/RateHistories.puml
}

package " アリーナ対戦情報 " {
    !include ../src/tables/ArenaSessions.puml
    !include ../src/tables/ArenaRounds.puml
    !include ../src/tables/ArenaParticipants.puml
}

package " 観測データ情報 " {
    !include ../src/tables/Observations.puml
    !include ../src/tables/ObservationDetails.puml
    !include ../src/tables/SequencePairs.puml
}

' プレイヤーからのリレーション（矢印を短く保つため方向をヒント指定）
Players ||-l-o{ Aliases
Players ||-l-o{ PlayerSeasonRatings
Players ||-l-o{ RateHistories
Players ||-d-o{ ArenaParticipants
Players ||-r-o{ ObservationDetails

' シーズンからのリレーション
Seasons ||--o{ PlayerSeasonRatings
Seasons ||--o{ RateHistories
Seasons ||--o{ ArenaSessions

' アリーナのリレーション
ArenaSessions ||--o{ ArenaRounds
ArenaSessions ||--o{ ArenaParticipants

' 観測データのリレーション
Observations ||--o{ ObservationDetails

@enduml
