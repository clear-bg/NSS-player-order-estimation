@startuml
!include ../../helper.puml

entity table_desc(Aliases, プレイヤーの別名（エイリアス）を管理するテーブル) {
    pk(id, INTEGER, 'サロゲートキー（自動インクリメントID）')
    col(alias_name, TEXT, '観測時に入力されたプレイヤーの別名')
    col(created_at, TEXT, 'レコード作成日時')
    col(is_deleted, INTEGER, '論理削除フラグ（trueで削除済み）')
    col(target_player_id, TEXT, '紐付け先となる正規のプレイヤーID（Playersテーブルの外部キー）')
    col(updated_at, TEXT, 'レコード最終更新日時')
}
@enduml
