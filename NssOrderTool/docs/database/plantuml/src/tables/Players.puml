@startuml
!include ../../helper.puml

entity table_desc(Players, プレイヤーの基本情報と成績を管理するテーブル) {
    pk(player_id, TEXT)
    col(created_at, TEXT, '作成日時')
    col(first_seen, TEXT, '初回観測日時')
    col(is_active, INTEGER, 'アクティブフラグ')
    col(is_deleted, INTEGER, '論理削除フラグ')
    col(last_played_at, TEXT, '最終対戦日時')
    col(memo, TEXT, '自由記述メモ')
    col(name, TEXT, '表示名')
    col(rate_mean, REAL, '現在のレート平均値（μ）')
    col(rate_sigma, REAL, '現在のレート不確実性（σ）')
    col(total_matches, INTEGER, '通算試合数')
    col(total_wins, INTEGER, '通算勝利数')
    col(updated_at, TEXT, '更新日時')
}
@enduml
