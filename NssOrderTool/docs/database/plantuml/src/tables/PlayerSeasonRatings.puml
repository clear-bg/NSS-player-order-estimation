@startuml
!include ../../helper.puml

entity table_desc(PlayerSeasonRatings, プレイヤーのシーズンごとのレート情報および成績（スナップショット）を管理するテーブル) {
    pk(id, INTEGER, 'シーズン別レート情報のサロゲートキー（自動インクリメントID）')
    col(created_at, TEXT, 'レコード作成日時')
    col(is_deleted, INTEGER, '論理削除フラグ（trueで削除済み）')
    fk(player_id, TEXT, '対象プレイヤーのID（Playersテーブルの外部キー）')
    col(rate_mean, REAL, 'このシーズンにおけるレート予測平均値（μ）')
    col(rate_sigma, REAL, 'このシーズンにおけるレート不確実性（σ）')
    fk(season_id, INTEGER, '対象シーズンのID（Seasonsテーブルの外部キー）')
    col(total_matches, INTEGER, 'このシーズンでの累計試合数')
    col(total_wins, INTEGER, 'このシーズンでの累計勝利数')
    col(updated_at, TEXT, 'レコード最終更新日時')
}
@enduml
