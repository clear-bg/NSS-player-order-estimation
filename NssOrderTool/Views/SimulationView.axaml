<UserControl
  x:Class="NssOrderTool.Views.SimulationView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="using:NssOrderTool.Models.UI"
  xmlns:vm="using:NssOrderTool.ViewModels"
  d:DesignHeight="500"
  d:DesignWidth="800"
  x:DataType="vm:SimulationViewModel"
  mc:Ignorable="d">

  <ScrollViewer VerticalScrollBarVisibility="Auto">

    <Grid Margin="20" ColumnDefinitions="*, 20, *">
      <StackPanel Grid.Column="0" Spacing="10">
        <TextBlock
          FontSize="16"
          FontWeight="Bold"
          Text="🎮 シミュレーション入力" />
        <TextBlock
          FontSize="12"
          Foreground="Gray"
          Text="参加する8人の名前を入力してください。1番目は部屋主（固定）です。"
          TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Inputs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:SimulationInputItem">
              <Grid Margin="0,5" ColumnDefinitions="30, *">
                <TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  FontWeight="Bold"
                  Text="{Binding Index, StringFormat='{}{0}.'}" />

                <AutoCompleteBox
                  Grid.Column="1"
                  FilterMode="Contains"
                  ItemsSource="{Binding $parent[UserControl].((vm:SimulationViewModel)DataContext).AllPlayerNames}"
                  MinimumPrefixLength="1"
                  Text="{Binding Name}"
                  Watermark="{Binding Placeholder}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel
          Margin="0,15,0,0"
          Orientation="Horizontal"
          Spacing="15">
          <Button
            Padding="25,10"
            Background="#007ACC"
            Command="{Binding RunSimulationCommand}"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                Text="▶️" />
              <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Text="計算する" />
            </StackPanel>
          </Button>

          <Button
            Padding="20,10"
            Background="#555555"
            Command="{Binding ClearInputsCommand}"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                Text="🧹" />
              <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Medium"
                Foreground="White"
                Text="クリア" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBlock
          Margin="0,5,0,0"
          Foreground="Green"
          Text="{Binding StatusText}"
          TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="10">
        <Grid ColumnDefinitions="Auto, *">
          <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            FontSize="16"
            FontWeight="Bold"
            Text="📊 推定結果" />

          <Button
            Grid.Column="1"
            Margin="10,0,0,0"
            Padding="8,2"
            HorizontalAlignment="Right"
            Command="{Binding TransferToArenaCommand}"
            Content="➡️ アリーナ集計へ反映"
            FontSize="14"
            ToolTip.Tip="この順序をアリーナ集計タブへ反映します" />
        </Grid>
        <TextBlock
          FontSize="12"
          Foreground="Gray"
          Text="内部データに基づく配置順の予測" />

        <ListBox
          Height="400"
          Background="#1E1E1E"
          BorderBrush="#333333"
          BorderThickness="1"
          CornerRadius="5"
          ItemsSource="{Binding SimulationResults}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel
                Margin="5"
                Orientation="Horizontal"
                Spacing="10">

                <TextBlock
                  Width="30"
                  VerticalAlignment="Center"
                  FontWeight="{Binding OrderWeight}"
                  Foreground="{Binding OrderColor}"
                  Text="{Binding OrderText}"
                  TextAlignment="Right" />

                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="15"
                  FontWeight="Bold"
                  Foreground="White"
                  Text="{Binding PlayerName}" />

                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="12"
                  Foreground="#AAAAAA"
                  Text="{Binding Suffix}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
