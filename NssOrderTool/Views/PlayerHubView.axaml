<UserControl
  x:Class="NssOrderTool.Views.PlayerHubView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="using:NssOrderTool.Models.UI"
  xmlns:vm="using:NssOrderTool.ViewModels"
  x:Name="Root"
  d:DesignHeight="600"
  d:DesignWidth="800"
  x:DataType="vm:PlayerHubViewModel"
  mc:Ignorable="d">

  <Grid>

    <Grid
      Margin="20"
      Background="Transparent"
      PointerPressed="OnBackgroundPointerPressed"
      RowDefinitions="Auto, Auto, *">

      <ScrollViewer
        Grid.Row="0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
          Grid.Row="0"
          Margin="0,0,0,30"
          Spacing="15">
          <TextBlock
            FontSize="18"
            FontWeight="Bold"
            Text="👤 プレイヤー＆エイリアス登録" />
          <StackPanel Orientation="Horizontal" Spacing="15">
            <StackPanel Spacing="5">
              <TextBlock
                FontSize="12"
                FontWeight="Bold"
                Text="プレイヤー名 (必須)" />
              <TextBox
                Width="200"
                KeyDown="OnInputKeyDown"
                Text="{Binding TargetInput}"
                Watermark="例: Takahiro" />
            </StackPanel>
            <StackPanel Spacing="5">
              <TextBlock
                FontSize="12"
                FontWeight="Bold"
                Text="エイリアス (カンマ区切り / 省略可)" />
              <TextBox
                Width="300"
                KeyDown="OnInputKeyDown"
                Text="{Binding AliasInput}"
                Watermark="例: Taka, たかひろ" />
            </StackPanel>
            <Button
              Height="32"
              Padding="20,0"
              VerticalAlignment="Bottom"
              VerticalContentAlignment="Center"
              Background="#007ACC"
              Command="{Binding RegisterPlayerCommand}"
              Content="登録 / 更新"
              Foreground="White" />
          </StackPanel>
          <TextBlock Foreground="Green" Text="{Binding StatusText}" />
        </StackPanel>
      </ScrollViewer>

      <GridSplitter
        Grid.Row="1"
        Height="4"
        Margin="0,10,0,20"
        HorizontalAlignment="Stretch"
        Background="#555555"
        CornerRadius="2" />

      <Grid Grid.Row="2" RowDefinitions="Auto, Auto, *">
        <Grid
          Grid.Row="0"
          Margin="0,0,0,10"
          ColumnDefinitions="*, Auto">
          <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            FontSize="18"
            FontWeight="Bold"
            Text="📋 登録済みプレイヤー一覧" />
          <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="10">

            <Button Classes.isEditing="{Binding IsEditing}" Command="{Binding ToggleEditModeCommand}">
              <Button.Styles>
                <Style Selector="Button">
                  <Setter Property="Background" Value="#555555" />
                  <Setter Property="Foreground" Value="White" />
                  <Setter Property="Content" Value="✏️ 編集" />
                </Style>
                <Style Selector="Button.isEditing">
                  <Setter Property="Background" Value="#E65100" />
                  <Setter Property="Content" Value="✅ 編集完了" />
                </Style>
              </Button.Styles>
            </Button>

            <Button
              Background="#555555"
              Command="{Binding ShowGraphCommand}"
              Content="グラフ出力"
              Foreground="White" />
            <Button
              Background="#555555"
              Command="{Binding LoadPlayersCommand}"
              Content="更新"
              Foreground="White" />
          </StackPanel>
        </Grid>

        <Border
          Grid.Row="1"
          Margin="0,0,0,10"
          Padding="15,10"
          Background="#2D2D30"
          BorderBrush="#555555"
          BorderThickness="1"
          CornerRadius="5">
          <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">

            <StackPanel
              Margin="0,0,25,0"
              Orientation="Horizontal"
              Spacing="8">
              <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                Text="🔍" />
              <TextBox
                Width="200"
                VerticalAlignment="Center"
                KeyDown="OnInputKeyDown"
                Text="{Binding SearchText}"
                Watermark="名前・エイリアスで検索" />
            </StackPanel>

            <StackPanel
              Margin="0,0,25,0"
              Orientation="Horizontal"
              Spacing="8">
              <TextBlock
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="#CCCCCC"
                Text="💤 非アクティブ判定:" />
              <NumericUpDown
                Width="120"
                VerticalAlignment="Center"
                FormatString="0"
                KeyDown="OnInputKeyDown"
                Maximum="3650"
                Minimum="1"
                Value="{Binding InactiveDaysThreshold}" />
              <TextBlock
                VerticalAlignment="Center"
                Foreground="#CCCCCC"
                Text="日未参加" />
            </StackPanel>

            <CheckBox
              VerticalAlignment="Center"
              Content="非アクティブなプレイヤーも表示する"
              Foreground="#DDDDDD"
              IsChecked="{Binding ShowInactivePlayers}" />

          </WrapPanel>
        </Border>

        <DataGrid
          x:Name="PlayerGrid"
          Grid.Row="2"
          Margin="0,10,0,0"
          AutoGenerateColumns="False"
          Background="#1E1E1E"
          BorderBrush="#555555"
          BorderThickness="1"
          CanUserReorderColumns="True"
          CanUserResizeColumns="True"
          CanUserSortColumns="True"
          GridLinesVisibility="Horizontal"
          IsReadOnly="True"
          ItemsSource="{Binding PlayerList}">

          <DataGrid.Columns>
            <DataGridTemplateColumn
              Width="*"
              Header="プレイヤー名"
              SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:PlayerHubItem">
                  <StackPanel Margin="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding Name}" />
                      <Button
                        Padding="6,2"
                        Background="#D32F2F"
                        Command="{Binding #Root.((vm:PlayerHubViewModel)DataContext).DeletePlayerCommand}"
                        CommandParameter="{Binding}"
                        Content="✕"
                        CornerRadius="10"
                        FontSize="12"
                        Foreground="White"
                        IsVisible="{Binding #Root.((vm:PlayerHubViewModel)DataContext).IsEditing}" />
                    </StackPanel>
                    <ItemsControl Margin="0,3,0,0" ItemsSource="{Binding Aliases}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border
                            Margin="0,0,5,3"
                            Padding="10,2"
                            Background="#555555"
                            CornerRadius="12">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#CCCCCC"
                                Text="{Binding}" />
                              <Button
                                Padding="4,0"
                                Background="Transparent"
                                Command="{Binding #Root.((vm:PlayerHubViewModel)DataContext).DeleteAliasCommand}"
                                CommandParameter="{Binding}"
                                Content="✕"
                                FontSize="10"
                                Foreground="#FF9999"
                                IsVisible="{Binding #Root.((vm:PlayerHubViewModel)DataContext).IsEditing}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn
              Width="80"
              Binding="{Binding Rating, StringFormat={}{0:F0}}"
              Header="レート" />

            <DataGridTextColumn
              Width="80"
              Binding="{Binding TotalMatches}"
              Header="参加数" />

            <DataGridTextColumn
              Width="100"
              Binding="{Binding WinRateString}"
              Header="1位獲得率"
              SortMemberPath="WinRateString" />

            <DataGridTemplateColumn Width="90" Header="操作">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:PlayerHubItem">
                  <Button
                    Margin="5"
                    Padding="10,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#007ACC"
                    Command="{Binding #Root.((vm:PlayerHubViewModel)DataContext).GoToArenaDataCommand}"
                    CommandParameter="{Binding}"
                    Content="📊 戦績"
                    CornerRadius="5"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="White" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>


    <Grid Background="#AA000000" IsVisible="{Binding IsShowDeleteConfirm}">

      <Border
        MinWidth="320"
        Padding="25"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#2D2D30"
        BoxShadow="0 4 10 0 #55000000"
        CornerRadius="8">

        <StackPanel Spacing="20">
          <TextBlock
            FontSize="18"
            FontWeight="Bold"
            Foreground="White"
            Text="⚠️ プレイヤーの削除確認" />

          <StackPanel Spacing="5">
            <TextBlock
              FontSize="14"
              Foreground="#CCCCCC"
              Text="以下のプレイヤーを削除しますか？" />
            <TextBlock
              Margin="0,10"
              HorizontalAlignment="Center"
              FontSize="16"
              FontWeight="Bold"
              Foreground="#FF5555"
              Text="{Binding PlayerToDelete.Name}" />
            <TextBlock
              FontSize="12"
              Foreground="#888888"
              Text="※この操作により、アリーナの戦績データが消えることはありません。（論理削除）"
              TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <Button
              Padding="15,6"
              Background="#555555"
              Command="{Binding CancelDeletePlayerCommand}"
              Content="キャンセル"
              Foreground="White" />
            <Button
              Padding="15,6"
              Background="#D32F2F"
              Command="{Binding ExecuteDeletePlayerCommand}"
              Content="削除する"
              FontWeight="Bold"
              Foreground="White" />
          </StackPanel>
        </StackPanel>

      </Border>
    </Grid>

  </Grid>
</UserControl>
