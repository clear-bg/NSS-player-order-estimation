<UserControl
  x:Class="NssOrderTool.Views.SeasonManagementView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:entities="using:NssOrderTool.Models.Entities"
  xmlns:ui="using:NssOrderTool.Models.UI"
  xmlns:vm="using:NssOrderTool.ViewModels"
  x:DataType="vm:SeasonManagementViewModel">

  <Grid>

    <Grid Margin="20" RowDefinitions="Auto, *, Auto">
      <Border
        Grid.Row="0"
        Padding="15"
        Background="#1E1E1E"
        CornerRadius="8">
        <Grid ColumnDefinitions="*, Auto">
          <StackPanel Grid.Column="0" Spacing="5">
            <TextBlock
              FontSize="14"
              Foreground="#AAAAAA"
              Text="現在のアクティブシーズン" />
            <TextBlock
              FontSize="24"
              FontWeight="Bold"
              Foreground="#4488FF"
              Text="{Binding ActiveSeason.Name, TargetNullValue='なし'}" />
          </StackPanel>
          <Button
            Grid.Column="1"
            Padding="15,10"
            VerticalAlignment="Center"
            Background="#007ACC"
            Command="{Binding CreateNewSeasonCommand}"
            CornerRadius="5"
            Foreground="White">
            <TextBlock FontWeight="Bold" Text="➕ 新しいシーズンを開始" />
          </Button>
        </Grid>
      </Border>

      <DataGrid
        Grid.Row="1"
        Margin="0,20,0,0"
        AutoGenerateColumns="False"
        BorderBrush="#333333"
        BorderThickness="1"
        GridLinesVisibility="All"
        IsReadOnly="True"
        ItemsSource="{Binding Seasons}">
        <DataGrid.Columns>
          <DataGridTextColumn
            Width="*"
            Binding="{Binding Name}"
            Header="シーズン名" />

          <DataGridTextColumn
            Width="*"
            Binding="{Binding StartDate, StringFormat='yyyy/MM/dd'}"
            Header="開始日" />

          <DataGridTextColumn
            Width="*"
            Binding="{Binding EndDateDisplay}"
            Header="終了日" />

          <DataGridTextColumn
            Width="80"
            Binding="{Binding ActiveStatusIcon}"
            Header="状態" />

          <DataGridTemplateColumn Width="150" Header="操作">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="ui:SeasonUIItem">
                <StackPanel
                  Margin="5"
                  Orientation="Horizontal"
                  Spacing="5">
                  <Button
                    Padding="10,5"
                    Command="{Binding $parent[UserControl].((vm:SeasonManagementViewModel)DataContext).SetActiveSeasonCommand}"
                    CommandParameter="{Binding}"
                    Content="適用"
                    IsEnabled="{Binding !IsActive}" />

                  <Button
                    Padding="10,5"
                    Background="#444444"
                    Command="{Binding $parent[UserControl].((vm:SeasonManagementViewModel)DataContext).OpenEditDialogCommand}"
                    CommandParameter="{Binding}"
                    Content="編集" />

                  <Button
                    Padding="10,5"
                    Background="#AA0000"
                    Command="{Binding $parent[UserControl].((vm:SeasonManagementViewModel)DataContext).ConfirmDeleteCommand}"
                    CommandParameter="{Binding}"
                    Content="削除"
                    Foreground="White"
                    IsEnabled="{Binding CanDelete}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock
        Grid.Row="2"
        Margin="0,10,0,0"
        Foreground="Green"
        Text="{Binding StatusMessage}" />
    </Grid>

    <Grid
      Background="#80000000"
      IsVisible="{Binding IsEditDialogOpen}"
      ZIndex="100">

      <Border
        Width="350"
        Padding="25"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#252526"
        BorderBrush="#3E3E42"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel Spacing="15">
          <TextBlock
            Margin="0,0,0,10"
            FontSize="18"
            FontWeight="Bold"
            Foreground="#4488FF"
            Text="シーズンの編集" />

          <TextBlock
            Margin="0,0,0,-10"
            Foreground="#AAAAAA"
            Text="シーズン名" />
          <TextBox Text="{Binding EditSeasonName}" />

          <TextBlock
            Margin="0,0,0,-10"
            Foreground="#AAAAAA"
            Text="開始日" />
          <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding EditStartDate}" />

          <TextBlock
            Margin="0,0,0,-10"
            Foreground="#AAAAAA"
            Text="終了日 (未定の場合は空欄)" />
          <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding EditEndDate}" />

          <StackPanel
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <Button
              Width="80"
              HorizontalContentAlignment="Center"
              Command="{Binding CloseEditDialogCommand}"
              Content="キャンセル" />
            <Button
              Width="80"
              HorizontalContentAlignment="Center"
              Background="#007ACC"
              Command="{Binding SaveEditCommand}"
              Content="保存"
              FontWeight="Bold"
              Foreground="White" />
          </StackPanel>

        </StackPanel>
      </Border>
    </Grid>

    <Grid
      Background="#80000000"
      IsVisible="{Binding IsDeleteDialogOpen}"
      ZIndex="101">

      <Border
        Width="350"
        Padding="25"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#252526"
        BorderBrush="#3E3E42"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel Spacing="15">
          <TextBlock
            HorizontalAlignment="Center"
            FontWeight="Bold"
            Foreground="#FFA500"
            Text="⚠️ 削除の確認" />

          <TextBlock
            Text="{Binding DeleteConfirmMessage}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

          <StackPanel
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="20">
            <Button
              Width="80"
              HorizontalContentAlignment="Center"
              Command="{Binding CancelDeleteCommand}"
              Content="キャンセル" />
            <Button
              Width="80"
              HorizontalContentAlignment="Center"
              Background="#D32F2F"
              Command="{Binding ExecuteDeleteCommand}"
              Content="削除する"
              FontWeight="Bold"
              Foreground="White" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>
