<UserControl
  x:Class="NssOrderTool.Views.SeasonManagementView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:entities="using:NssOrderTool.Models.Entities"
  xmlns:ui="using:NssOrderTool.Models.UI"
  xmlns:vm="using:NssOrderTool.ViewModels"
  x:DataType="vm:SeasonManagementViewModel">

  <Grid Margin="20" RowDefinitions="Auto, *, Auto">
    <Border
      Grid.Row="0"
      Padding="15"
      Background="#1E1E1E"
      CornerRadius="8">
      <Grid ColumnDefinitions="*, Auto">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock
            FontSize="14"
            Foreground="#AAAAAA"
            Text="現在のアクティブシーズン" />
          <TextBlock
            FontSize="24"
            FontWeight="Bold"
            Foreground="#4488FF"
            Text="{Binding ActiveSeason.Name, TargetNullValue='なし'}" />
        </StackPanel>
        <Button
          Grid.Column="1"
          Padding="15,10"
          VerticalAlignment="Center"
          Background="#007ACC"
          Command="{Binding CreateNewSeasonCommand}"
          CornerRadius="5"
          Foreground="White">
          <TextBlock FontWeight="Bold" Text="➕ 新しいシーズンを開始" />
        </Button>
      </Grid>
    </Border>

    <DataGrid
      Grid.Row="1"
      Margin="0,20,0,0"
      AutoGenerateColumns="False"
      BorderBrush="#333333"
      BorderThickness="1"
      GridLinesVisibility="All"
      IsReadOnly="True"
      ItemsSource="{Binding Seasons}">
      <DataGrid.Columns>
        <DataGridTextColumn
          Width="*"
          Binding="{Binding Name}"
          Header="シーズン名" />
        <DataGridTextColumn
          Width="*"
          Binding="{Binding StartDate, StringFormat='yyyy/MM/dd'}"
          Header="開始日" />

        <DataGridTextColumn
          Width="*"
          Binding="{Binding EndDateDisplay}"
          Header="終了日" />

        <DataGridTextColumn
          Width="80"
          Binding="{Binding ActiveStatusIcon}"
          Header="状態" />

        <DataGridTemplateColumn Width="100" Header="操作">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="ui:SeasonUIItem">
              <Button
                Margin="5"
                Padding="10,5"
                Command="{Binding $parent[UserControl].((vm:SeasonManagementViewModel)DataContext).SetActiveSeasonCommand}"
                CommandParameter="{Binding}"
                Content="適用"
                IsEnabled="{Binding !IsActive}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock
      Grid.Row="2"
      Margin="0,10,0,0"
      Foreground="Green"
      Text="{Binding StatusMessage}" />
  </Grid>
</UserControl>
