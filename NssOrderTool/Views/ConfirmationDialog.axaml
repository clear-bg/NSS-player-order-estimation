<Window
  x:Class="NssOrderTool.Views.ConfirmationDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="確認"
  Width="350"
  d:DesignWidth="350"
  CanResize="False"
  SizeToContent="Height"
  SystemDecorations="BorderOnly"
  WindowStartupLocation="CenterOwner"
  mc:Ignorable="d">

  <Grid Margin="25" RowDefinitions="Auto, Auto">
    <StackPanel
      Grid.Row="0"
      VerticalAlignment="Center"
      Spacing="15">
      <TextBlock
        HorizontalAlignment="Center"
        FontWeight="Bold"
        Foreground="#FFA500"
        Text="⚠️ 確認" />

      <TextBlock
        x:CompileBindings="False"
        Text="{Binding}"
        TextAlignment="Left"
        TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel
      Grid.Row="1"
      Margin="0,20,0,0"
      HorizontalAlignment="Center"
      Orientation="Horizontal"
      Spacing="20">
      <Button
        Name="CancelButton"
        Width="80"
        Click="CancelButton_Click"
        Content="キャンセル" />

      <Button
        Name="OkButton"
        Width="80"
        Background="#007ACC"
        Click="OkButton_Click"
        Content="OK"
        FontWeight="Bold"
        Foreground="White" />
    </StackPanel>
  </Grid>
</Window>
